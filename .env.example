# Copy this file to `.env` (or `.env.local`) and adjust the host.
#
# Root URL of the AquaLav backend WITHOUT the `/api/v1` prefix: the HTTP client
# in `src/services/api-client.ts` appends that prefix to every path.
#
# Leave it empty to let the app infer the host from the Metro bundler URL, which
# is what you want on a physical device connected through Expo Go. Remember to
# start uvicorn with `--host 0.0.0.0` so the phone can reach it.
#
# Examples:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000   # LAN IP of the PC running uvicorn
#   EXPO_PUBLIC_API_URL=http://localhost:8000      # web / iOS simulator
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000       # Android emulator
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
